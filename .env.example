# qq-ai-bot 环境变量样例
# 用法：
#   本地   set -a; . ./.env; set +a; node bridge.mjs
#   服务器 cp .env.example /etc/qq-bot.env   （systemd EnvironmentFile 格式：KEY=VALUE，# 注释）

# ── 接入 ──────────────────────────────────────────────────────────────
NAPCAT_WS=ws://127.0.0.1:3001
NAPCAT_TOKEN=

# 只回这些 QQ 号，逗号分隔。留空 = 回所有人（不推荐）
ALLOW_FROM=

# ── 节流 ──────────────────────────────────────────────────────────────
MIN_GAP_MS=2000
MAX_REPLY_CHARS=800
HISTORY_TURNS=12
MERGE_BURST_MS=5000
MERGE_BURST_MAX_MS=20000
MULTI_GAP_MS=700
MULTI_MAX_SEGMENTS=4

# ── 后端 ──────────────────────────────────────────────────────────────
# dsh（默认，真 agent）/ acp / deepseek
BACKEND=dsh
QQ_BOT_PROFILE=headless
DSH_TIMEOUT_MS=90000
DSH_KILL_GRACE_MS=5000
DSH_IDLE_DONE_MS=20000
# DSH_CWD=/opt/qq-bot
# SELFCHECK=1
# CONFIG_GUARD=1

# deepseek 回退后端
# DEEPSEEK_API_KEY=
# API_BASE=https://api.deepseek.com
# MODEL=deepseek-chat

# ── 记忆 ──────────────────────────────────────────────────────────────
# MEMORY_PATH=./memory.md
HISTORY_RESTORE=1
HISTORY_RESTORE_HOURS=36
DIARY_IN_PROMPT=1
RECALL=1
RECALL_DAYS=90
RECALL_LIMIT=8

# ── 语音 ──────────────────────────────────────────────────────────────
VOICE_ENABLED=1
VOICE_AUTO=1
VOICE_NAME=zh-CN-XiaoyiNeural

# ── 看图 ──────────────────────────────────────────────────────────────
IMAGE_ENABLED=1
VISION_ENABLED=1
# Linux 上没有 ocr.exe，必须关掉
OCR_ENABLED=0
ANIM_FRAMES=6
IMAGE_REATTACH_MS=600000

# ── 群聊（留空 = 不接群）──────────────────────────────────────────────
GROUP_ENABLED=1
GROUP_ALLOW=
GROUP_WAKE=小玉
GROUP_CONTEXT_MAX=120
GROUP_CONTEXT_MAX_CHARS=1800
GROUP_REPLY_QUOTE=1

# ── 生图 ──────────────────────────────────────────────────────────────
# pollinations（免 key）/ openai（任意 OpenAI 兼容接口）/ off
IMAGE_GEN_ENABLED=1
IMAGE_GEN_PROVIDER=pollinations
# IMAGE_GEN_API_KEY=
# IMAGE_GEN_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_GEN_MODEL=
IMAGE_GEN_SIZE=768x768
IMAGE_GEN_MIN_GAP_MS=45000

# ── 主动行为 ──────────────────────────────────────────────────────────
PROACTIVE_ENABLED=1
PROACTIVE_MIN_GAP_H=3
PROACTIVE_MAX_GAP_H=6
PROACTIVE_QUIET_START=0
PROACTIVE_QUIET_END=8
PROACTIVE_DAILY_MAX=4

QZONE_ENABLED=1
QZONE_DAILY_TIMES=1
QZONE_RIGHT=4
QZONE_DRY_RUN=0
QZONE_HOUR_START=20
QZONE_HOUR_END=22

DIARY_ENABLED=1
DIARY_HOUR_START=22
DIARY_HOUR_END=23

WEEKLY=1
WEEKLY_DAY=0
WEEKLY_HOUR_START=9
WEEKLY_HOUR_END=11
WEEKLY_DAYS=7
WEEKLY_MIN_LINES=12

# ── 跨机渲染（可选，需另一台有 GPU 的机器）─────────────────────────────
# 协议见 docs/remote-render.md
# SVC_INBOX=./.run/svc-inbox
# SVC_OUTBOX=./.run/svc-outbox
# SVC_ASR_INBOX=./.run/svc-asr-inbox

# ── 点歌换声 ──────────────────────────────────────────────────────────
# volc（火山引擎，需 key）/ local（本地 SoulX 或 so-vits）
# SING_PROVIDER=volc
# VOLC_SING_APPKEY=
# VOLC_SING_TOKEN=

# ── 时区 ──────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
